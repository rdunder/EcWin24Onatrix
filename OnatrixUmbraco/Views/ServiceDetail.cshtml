@using OnatrixUmbraco.ViewModels
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ServiceDetail>
@{
	Layout = "mainTemplate.cshtml";
	
}
<partial name="Partials/Layout/_PageHeader" model="(IPageHeader)Model"/>
<section class="service-detail-section">
	<div class="container">
		<div class="main-content">
			<aside>
				@Html.GetBlockListHtml(Model.ServiceDetailAsides)
			</aside>
			<div class="divider"></div>
			<div class="content">
				<img src="@Model.ServiceDetailThumbnail.Url()" alt="@Model.Name"/>
				@Model.ServiceDetailBody
			</div>
		</div>
		<div class="service-page-form">
			<h3>Have a question ?</h3>
			<partial name="Partials/Forms/QuestionForm" model="@(new QuestionFormViewModel())"/>
		</div>
	</div>
</section>