@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    var content = (ContentModels.InfoCard)Model.Content;
}

<div class="widget-info-card">
    <h3>@content.InfoCardTitle</h3>
    <img src="@(content?.InfoCardImage?.Url() ?? "~/images/services-financial-advisor.svg")"/>
    <p>@content.InfoCardText</p>
</div>

<div class="widget-contact-us-card">
    <h3>How can we help you?</h3>
    <p>online support 24/7, we are here to help you</p>
    <a class="btn-secondary" href="#questionForm">Contact Us</a>
</div>