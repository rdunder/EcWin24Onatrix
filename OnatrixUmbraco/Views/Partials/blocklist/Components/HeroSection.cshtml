@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    var content = (ContentModels.HeroSection)Model.Content;
    var settings = Model.Settings as ContentModels.HeroSection;
}


<section class="hero" style="background-image: url(@content.HeroBgImage.Url())">
    <div class="container">
        <div class="content">
            <h1>@content.HeroTitle</h1>
            <p>@content.HeroText</p>
            <a href="@content.HeroLink?.Url ?? ''" class="btn-primary">@content.HeroLink.Name</a>
        </div>
    </div>
</section>