@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    var content = (ContentModels.ServiceSection)Model.Content;
    var settings = Model.Settings as ContentModels.ServiceSettings;

    var backgroundColor = settings?.ServicesBgColor?.Color ?? "#FFFFFF";

    var currentPage = Umbraco.AssignedContentItem;
    var siteRoot = currentPage.Root();

    var servicePage = siteRoot.Children<ServicePage>()?.FirstOrDefault();
    var items = servicePage?
        .Children<ServiceDetail>()?
        .OrderByDescending(x => x.CreateDate).ToList() ?? [];
}

<section class="services" style="background-color: @backgroundColor">
    <div class="container">
        @if (settings!.ShowServicesLabel)
        {
            <span class="section-label">@content.ServicesLabel</span>
        }
        
        <h2>@content.ServicesTitle</h2>
        
        <div class="service-card-list">
            @if (items.Any())
            {
                foreach (var item in items)
                {
                    <div class="service-card">
                        <a href="@item.Url()">
                            <h3>@item.Name</h3>

                            <img src="@item.ServiceDetailThumbnail?.Url()" alt="@item.Name"/>

                            <p>@item.ServiceDetailExcerpt</p>
                        </a>
                    </div>
                }    
            }
            else
            {
                <p>No Services Available</p>
            }
        </div>
        
        
        
        @* @Html.GetBlockListHtml(content.ServicesList) *@
        
    </div>
</section>