@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>;
@using OnatrixUmbraco.ViewModels
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    var content = (ContentModels.ContactSection)Model.Content;
    // var settings = Model.Settings as ContentModels.HeroSection;
    
    var rootContent = Umbraco.ContentAtRoot();
    var siteSettings = rootContent.OfType<ContentModels.SiteSettings>().FirstOrDefault();
    var callbackFormOptions = siteSettings?.CallbackFormOptions ?? [];
    var callbackFormModel = new CallbackFormViewModel() { Options = callbackFormOptions };
}

<section class="contact-section" style="background-image: url(@content.ContactSectionBgImage?.Url())">
    <div class="container">
        <div class="content">
            <span class="section-label">@content.ContactSectionLabel</span>
            <h2>@content.ContactSectionTitle</h2>
            <p>@content.ContactSectionText</p>
        </div>
        
        <partial name="Partials/Forms/CallbackForm" model="callbackFormModel"/>
        
        @if (TempData["FormError"] != null)
        {
            <div class="form-feedback-error">
                <p>@TempData["FormError"]</p>
            </div>
        }
        else if (TempData["Success"] != null)
        {
            <div class="form-feedback-success">
                <p>@TempData["Success"]</p>
            </div>
        }
    </div>
</section>