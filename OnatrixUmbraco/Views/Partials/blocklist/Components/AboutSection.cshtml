@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>;
@using OnatrixUmbraco.ViewModels
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    var content = (ContentModels.AboutSection)Model.Content;
    var settings = Model.Settings as ContentModels.AboutSectionSettings;

    var options = settings?.CallbackRequestOptions ?? [];
    var callbackFormModel = new CallbackFormViewModel() { Options = options };
    
    var rootContent = Umbraco.ContentAtRoot();
    var siteSettings = rootContent.OfType<ContentModels.SiteSettings>().FirstOrDefault();
}

<section class="about-us">
    <div class="container">
        <div class="about-content">
            <span class="section-label">@content.AboutLabel</span>
            <h2>@content.AboutTitle</h2>
            <p>@content.AboutText</p>
            <div class="about-ceo">
                @if (siteSettings?.CeoSignature != null)
                {
                    <img src="@siteSettings.CeoSignature?.Url()" alt=@($"{@siteSettings.CeoName} Signature")/>
                }
                @if (siteSettings?.CeoName != null && siteSettings.CeoTitle != null)
                {
                    <span>@siteSettings.CeoName - @siteSettings.CeoTitle</span>
                }
            </div>
        </div>
        <div class="about-form">
            <h3>@content.AboutCallbackFormTitle</h3>
            <p>@content.AboutCallbackFormDescription</p>
            
            <partial name="Partials/Forms/CallbackForm" model="callbackFormModel"/>
            
            @if (TempData["FormError"] != null)
            {
                <div class="form-feedback-error">
                    <p>@TempData["FormError"]</p>
                </div>
            }
            else if (TempData["Success"] != null)
            {
                <div class="form-feedback-success">
                    <p>@TempData["Success"]</p>
                </div>
            }
            
        
        </div>
    </div>
</section>