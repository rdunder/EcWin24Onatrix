@using OnatrixUmbraco.Controllers
@using OnatrixUmbraco.ViewModels
@model OnatrixUmbraco.ViewModels.CallbackFormViewModel

@using (
    Html.BeginUmbracoForm(
        "Submit", 
        "CallbackForm", 
        FormMethod.Post,
        new { novalidate = "novalidate", id = "callbackForm" }
    )
)
{
    
        <div class="input-group">
            <label asp-for="Name" class="sr-only"></label>
            <input asp-for="Name" type="text" placeholder="@Html.DisplayNameFor(x => x.Name)"/>
            <span asp-validation-for="Name"></span>
        </div>
        
        <div class="input-group">
            <label asp-for="Email" class="sr-only"></label>
            <input asp-for="Email" type="text" placeholder="@Html.DisplayNameFor(x => x.Email)"/>
            <span asp-validation-for="Email"></span>
        </div>
        
        <div class="input-group">
            <label asp-for="Phone" class="sr-only"></label>
            <input asp-for="Phone" type="text" placeholder="@Html.DisplayNameFor(x => x.Phone)"/>
            <span asp-validation-for="Phone"></span>
        </div>
        
        <div class="input-group">
            <label asp-for="SelectedOption" class="sr-only"></label>
            
            <div class="custom-select-input">
                <select asp-for="SelectedOption">
                    <option value="" disabled hidden selected>Please select an option</option>
                    <option value="Financial Consulting">Financial Consulting</option>
                    <option value="Assurance Consulting">Assurance Consulting</option>
                    <option value="Tax Consulting">Tax Consulting</option>
                </select>
                <span class="select-input-icon"><i class="fa-solid fa-angle-down"></i></span>
            </div>
            
            <span asp-validation-for="SelectedOption"></span>
        </div>
        
        <button type="submit">Submit</button>
}